{
	"name": "svelte-portfolio-worker",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-19",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"observability": { "enabled": true },
	"secrets": { "required": ["API_KEY"] },
	"previews": {}
}
